<Window x:Class="LED_Controller.Views.AmbilightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:LED_Controller.Models"
        xmlns:vm="clr-namespace:LED_Controller.ViewModels"
        Title="Ambilight-Einstellungen" Height="500" Width="640">
    <StackPanel Margin="16">
        <TextBlock Text="Monitor auswählen:" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" 
                  DisplayMemberPath="DeviceName" Width="280"/>

        <TextBlock Text="Strip auswählen:" FontWeight="Bold" Margin="0,16,0,4"/>
        <ComboBox ItemsSource="{Binding Strips}" SelectedItem="{Binding SelectedStrip}" 
                  DisplayMemberPath="Strip.Name" Width="280"/>

        <!-- Einstellungen für den Mapping-Modus -->
        <TextBlock Text="Mapping-Modus:" FontWeight="Bold" Margin="0,16,0,4"/>
        <ComboBox ItemsSource="{Binding Source={x:Static vm:AmbilightViewModel.AmbilightModeValues}}"
          SelectedItem="{Binding SelectedStrip.Mapping.Mode, Mode=TwoWay}" Width="200"/>


        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Start-LED (0-basiert):" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Text="{Binding SelectedStrip.Mapping.StartLedIndex, Mode=TwoWay}" Width="40"/>
            <TextBlock Text="Zone Breite:" Margin="24,0,8,0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SelectedStrip.Mapping.ZoneWidth, Mode=TwoWay}" Width="40"/>
            <TextBlock Text="Zone Höhe:" Margin="12,0,8,0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SelectedStrip.Mapping.ZoneHeight, Mode=TwoWay}" Width="40"/>
            <TextBlock Text="Abstand vom Rand:" Margin="12,0,8,0" VerticalAlignment="Center"/>
            <TextBox Text="{Binding SelectedStrip.Mapping.MarginPx, Mode=TwoWay}" Width="40"/>
        </StackPanel>

        <!-- Buttons für Start/Stop Test -->
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Content="Ambilight-Test starten" Command="{Binding StartTestCommand}" Width="170" Margin="0,0,16,0"/>
            <Button Content="Stopp" Command="{Binding StopTestCommand}" Width="90"/>
            <TextBlock Text="FPS:" Margin="36,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding CurrentFps}" Width="40" VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</Window>
